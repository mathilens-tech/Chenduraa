# =============================================================================
# Chenduraa Energy — website configuration
# =============================================================================
# Copy this file to `.env.local` for local development, and set the same values
# as Azure Static Web Apps build-time environment variables for production.
#
# Every value is OPTIONAL. Anything left unset simply does not render — the site
# never shows a placeholder. Values marked REQUIRED BEFORE LAUNCH are needed for
# the site to be genuinely useful in production.
# =============================================================================

# Canonical site origin, no trailing slash. Used for canonical URLs, Open Graph
# tags, sitemap.xml and robots.txt.  REQUIRED BEFORE LAUNCH.
# If the site is served from a sub-path (see VITE_BASE_PATH), include it here:
#   https://<user>.github.io/Chenduraa
VITE_SITE_URL=https://www.chenduraaenergy.com

# Sub-path the site is served from. Leave BLANK for Azure Static Web Apps, a
# custom domain, or a GitHub user/org site — all serve from the root.
# Set it to the repository name only for a GitHub Pages *project* site
# (https://<user>.github.io/<repo>/). Example: Chenduraa
VITE_BASE_PATH=

# --- Contact details -------------------------------------------------------
# Display phone number, exactly as it should appear on the site.
# REQUIRED BEFORE LAUNCH.
VITE_CONTACT_PHONE=

# The same number in E.164 digits only (country code + number, no +, spaces or
# dashes) — used to build tel: and wa.me links. Example: 919876543210
VITE_CONTACT_PHONE_E164=

# Official enquiry email address.  REQUIRED BEFORE LAUNCH.
VITE_CONTACT_EMAIL=

# WhatsApp number in E.164 digits only. Falls back to VITE_CONTACT_PHONE_E164
# when unset. Leave both blank and the floating button links to the contact
# form instead of WhatsApp.
VITE_WHATSAPP_E164=

# --- Offices ---------------------------------------------------------------
# Set to true only once the Chennai office is confirmed.
VITE_OFFICE_CHENNAI_ENABLED=false

# --- Solutions -------------------------------------------------------------
# Set to true only if industrial solar is an offered service.
VITE_SOLUTION_INDUSTRIAL_ENABLED=false

# --- Social profiles -------------------------------------------------------
# Full URLs. The footer social block is hidden entirely when all are blank.
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_YOUTUBE=

# --- Lead handling ---------------------------------------------------------
# HTTPS endpoint that accepts POST JSON enquiries. When set, the contact form
# posts to it. When blank, the form falls back to a prefilled mailto: using
# VITE_CONTACT_EMAIL. See README "Contact form" for the payload shape.
#
# Works as-is with hosted form services (no backend of our own needed):
#   Formspree   https://formspree.io/f/xxxxxxxx
#   Web3Forms   https://api.web3forms.com/submit      (also set the access key)
#   Getform     https://getform.io/f/xxxxxxxx
#   FormSubmit  https://formsubmit.co/ajax/you@example.com
VITE_LEAD_ENDPOINT=

# Public form key, if your service wants one in the request body.
# Web3Forms calls this `access_key`. Safe to expose — it only allows posting
# to that one form.
VITE_LEAD_ACCESS_KEY=

# --- Google Maps -----------------------------------------------------------
# Optional. Without a key the Contact page uses the keyless Google Maps embed,
# which is fine for a city-level map.
VITE_GOOGLE_MAPS_EMBED_KEY=
